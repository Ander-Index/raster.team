=   Game_Over
~   Count__Game_Over ++
{
-   Flag__Work__Gym == 1:
    ~   INDEX = INDEX + 10
-   else:
    ~   INDEX = INDEX + 5
}
<-  Page__Endings.Ending__Work__Gym
->  Menu__Game_Over