---
/**
 * Accessible language switcher.
 *
 * Pages that have a non-1:1 translation (posts with different slugs,
 * translated tag names, categories that exist in only some locales,
 * partially generated pagination) pass an explicit `languageLinks` map
 * through BaseLayout -> Topbar. The server-rendered hrefs are therefore
 * correct before any client JavaScript runs.
 *
 * When no map is supplied (home, archives, taxonomy indexes, search),
 * we strip the current pathname's locale prefix and rebuild it for the
 * target — these pages are generated in every locale.
 */

import { SITE, type Locale } from '../../config';
import {
  useTranslations,
  localizedPath,
  stripLocale,
  localeLabel,
  type LanguageLinks,
} from '../../i18n/utils';
import { Icon } from 'astro-icon/components';

export interface Props {
  locale: Locale;
  /**
   * Explicit locale -> already-localized path map. Locales absent from
   * the map are not offered. When omitted, `availableLocales` (or all
   * locales) are assumed to have the same path.
   */
  languageLinks?: LanguageLinks;
  /**
   * Locales for which a translation of the current page actually
   * exists. Only used as a fallback when `languageLinks` is absent.
   */
  availableLocales?: readonly Locale[];
}

const { locale, languageLinks, availableLocales } = Astro.props as Props;
const t = useTranslations(locale);
const fallbackBase = stripLocale(Astro.url.pathname);

/** locale -> actual href, computed entirely at build time. */
const links: LanguageLinks = {};
if (languageLinks) {
  for (const l of SITE.locales) {
    const href = languageLinks[l];
    if (href) links[l] = href;
  }
  // Defensive: the current page must always point at itself.
  if (!links[locale]) links[locale] = localizedPath(fallbackBase, locale);
} else {
  const allowed = new Set<Locale>([locale, ...((availableLocales ?? SITE.locales) as Locale[])]);
  for (const l of SITE.locales) {
    if (allowed.has(l)) links[l] = localizedPath(fallbackBase, l);
  }
}

const otherLocales = SITE.locales.filter((l) => l !== locale && links[l]);
const currentHref = links[locale] ?? localizedPath(fallbackBase, locale);
---

{
  /* If the current page has no translations in any other locale, the
     switcher is just a static label \u2014 hide it entirely to avoid a
     dead-end menu. */
  otherLocales.length > 0 && (
    <div class="dropdown dropdown-end">
      <div
        tabindex="0"
        role="button"
        class="chirpy-social"
        aria-haspopup="menu"
        aria-label={t('lang.switcher')}
        title={t('lang.switcher')}
      >
        <Icon name="lucide:languages" width={16} height={16} />
      </div>
      <ul
        tabindex="0"
        class="menu dropdown-content rounded-box border-base-300 bg-base-100 z-50 mt-2 w-44 border p-2 shadow-lg"
        role="menu"
        data-lang-switcher
      >
        <li class="menu-title text-base-content/70 px-2 py-1 text-xs tracking-wide uppercase">
          {t('lang.switcher')}
        </li>
        <li>
          <a href={currentHref} aria-current="true" class="font-medium">
            <span class="badge badge-primary badge-sm">{locale.toUpperCase()}</span>
            {localeLabel(locale)}
          </a>
        </li>
        {otherLocales.map((target) => (
          <li>
            <a href={links[target]} data-lang-target={target}>
              <span class="badge badge-ghost badge-sm">{target.toUpperCase()}</span>
              {localeLabel(target)}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
