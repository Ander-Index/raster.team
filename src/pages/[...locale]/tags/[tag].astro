---
import { SITE, type Locale } from '~/config';
import { TAG_GROUPS } from '~/tag-groups';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostList from '~/components/PostList.astro';
import { useTranslations, localizedPath } from '~/i18n/utils';
import { getPosts, getTagsWithCount, slugify, resolveTagTranslations } from '~/utils/posts';

interface Props {
  tagName: string;
  locale: Locale;
}

export async function getStaticPaths() {
  let paths = [];
  // 1) One page per tag that actually has posts.
  for (const locale of SITE.locales) {
    const tags = await getTagsWithCount(locale);
    const localeParams = { locale: locale === SITE.defaultLocale ? undefined : locale };
    paths.push(
      ...tags.map((tag) => ({
        params: { ...localeParams, tag: slugify(tag.name) },
        props: { tagName: tag.name, locale },
      })),
    );
  }
  // 2) Ensure every tag-group member has a page in every locale, even
  //    when that locale has no posts for it yet. This keeps navbar
  //    entries and the language switcher linking to real pages instead
  //    of 404ing; empty ones show the "no posts" state (and are noindex).
  const seen = new Set(paths.map((p) => `${p.props.locale}:${p.params.tag}`));
  for (const group of TAG_GROUPS) {
    for (const locale of SITE.locales) {
      const name = group[locale];
      if (!name) continue;
      const slug = slugify(name);
      const key = `${locale}:${slug}`;
      if (seen.has(key)) continue;
      seen.add(key);
      paths.push({
        params: { locale: locale === SITE.defaultLocale ? undefined : locale, tag: slug },
        props: { tagName: name, locale },
      });
    }
  }
  return paths;
}

const { tagName, locale } = Astro.props as Props;
const { tag } = Astro.params;
const t = useTranslations(locale);
const posts = (await getPosts(locale)).filter((p) => p.data.tags.some((tg) => slugify(tg) === tag));

// Resolve every locale variant of this tag (translated via the table in
// src/tag-groups.ts, or shared verbatim, e.g. "UTAU").
const { links: translationLinks, paths: hreflangPaths } = await resolveTagTranslations(
  tagName,
  locale,
);
const availableLocales = (Object.keys(translationLinks) as Locale[]).sort();
---

<BaseLayout
  title={`#${tagName}`}
  pathWithoutLocale={`/tags/${tag}/`}
  hreflangPaths={hreflangPaths}
  availableLocales={availableLocales}
  noindex={posts.length === 0}
  crumbs={[
    { label: t('tags.title'), href: localizedPath('/tags/', locale) },
    { label: `#${tagName}` },
  ]}
>
  <header class="mb-6">
    <p class="text-base-content/70 text-sm tracking-wide uppercase">{t('list.tagPosts')}</p>
    <h1 class="text-3xl font-bold tracking-tight">#{tagName}</h1>
    <p class="text-base-content/70 mt-1 text-sm">
      {posts.length}
      {posts.length === 1 ? t('list.totalPostsOne') : t('list.totalPosts')}
    </p>
  </header>
  <PostList posts={posts} locale={locale} />
</BaseLayout>

{/* Translation links exposed for the LanguageSwitcher to read at runtime.
    Same mechanism PostLayout uses; without this the switcher would fall
    back to same-slug-different-locale and 404 on translated tags. */}
<script is:inline define:vars={{ links: translationLinks }}>
  window.__chirpyTranslations = links;
</script>
